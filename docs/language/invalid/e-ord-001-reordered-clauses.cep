-- expect: E-ORD-001 (clause order is fixed: within, after match, late events) @ 9:3
language cep/0.1;
stream S (a string, ts timestamp) time ts watermark bounded 1 min;
stream T (a string, ts timestamp);
rule ReorderedClauses
  intent 'x'
  partition by a of S ttl 1 hour
  from every e1 = S[a == 'x'] -> e2 = S[a == 'y']
  late events drop
  after match skip past last
  within 5 min
  select e1.a
  insert into T;
