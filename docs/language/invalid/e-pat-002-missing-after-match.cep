-- expect: E-PAT-002 (every pattern states its after-match policy) @ 10:3
language cep/0.1;
stream S (a string, ts timestamp) time ts watermark bounded 1 min;
stream T (a string, ts timestamp);
rule NoAfterMatch
  intent 'x'
  partition by a of S ttl 1 hour
  from every e1 = S[a == 'x'] -> e2 = S[a == 'y']
  within 5 min
  late events drop
  select e1.a
  insert into T;
