-- expect: E-SEL-001 (Out.kind is bound by no select item) @ 12:3
language cep/0.1;

stream S (k string, kind string, n int, ts timestamp)
  time ts watermark bounded 1 min idle after 1 min;

stream Out (k string, kind string, ts timestamp);

rule R
  intent 'Forward matching events.'
  from S[kind == 'x']
  select k
  insert into Out;
