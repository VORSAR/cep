-- expect: E-TBL-001 (Grants has a two-column primary key) @ 13:15
language cep/0.1;

stream S (k string, kind string, n int, ts timestamp)
  time ts watermark bounded 1 min idle after 1 min;

table Grants (k string, app string) primary key (k, app);

stream Out (k string, ts timestamp);

rule R
  intent 'Forward matching events.'
  from S[k in Grants]
  select k
  insert into Out;
