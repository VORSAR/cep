-- expect: E-FN-001 (count lives only in window rules) @ 12:13
language cep/0.1;

stream S (k string, kind string, n int, ts timestamp)
  time ts watermark bounded 1 min idle after 1 min;

stream Out (k string, total int, ts timestamp);

rule R
  intent 'Forward matching events.'
  from S[kind == 'x']
  select k, count() as total
  insert into Out;
