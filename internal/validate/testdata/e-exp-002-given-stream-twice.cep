-- expect: E-EXP-002 (S is given twice; give each stream one list) @ 15:16
language cep/0.1;

stream S (k string, n int, ts timestamp)
  time ts watermark bounded 1 min;

table T (k string) primary key (k);

stream Out (k string, ts timestamp);

rule R
  intent 'Forward the keys not in T.'
  from S[k not in T]
  expect given S [ {k: 'a', n: 1, ts: timestamp '2026-01-01T10:00:00Z'} ]
         given S [ {k: 'b', n: 1, ts: timestamp '2026-01-01T10:01:00Z'} ]
         then Out [ {k: 'a', ts: timestamp '2026-01-01T10:00:00Z'}, {k: 'b', ts: timestamp '2026-01-01T10:01:00Z'} ]
  select k
  insert into Out;
