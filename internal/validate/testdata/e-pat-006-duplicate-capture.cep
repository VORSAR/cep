-- expect: E-PAT-006 (capture o is named twice) @ 12:39
language cep/0.1;

stream S (k string, kind string, n int, ts timestamp)
  time ts watermark bounded 1 min idle after 1 min;

stream Out (why string, ts timestamp);

rule R
  intent 'An open, then a close on the same key.'
  partition by k of S ttl 1 hour
  from every o = S[kind == 'open'] -> o = S[kind == 'close']
  within 5 min
  after match skip past last
  late events drop
  select 'open-then-close' as why
  insert into Out;
