-- expect: E-TTL-002 (ttl 5 min is smaller than the delay extent 10 min) @ 11:27
language cep/0.1;

stream S (k string, kind string, n int, ts timestamp)
  time ts watermark bounded 1 min idle after 1 min;

stream Out (k string, kind string, ts timestamp);

rule R
  intent 'Re-time every event later.'
  partition by k of S ttl 5 min
  from S window delay(10 min)
  emit on due
  late events drop
  select k, kind
  insert into Out;
