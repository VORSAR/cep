-- expect: E-EXP-002 (rule R does not read table T2) @ 18:22
language cep/0.1;

stream S (k string, n int, ts timestamp)
  time ts watermark bounded 1 min;

table T (k string) primary key (k);

stream Out (k string, ts timestamp);

table T2 (k string) primary key (k);

stream Out2 (k string, ts timestamp);

rule R
  intent 'Forward the keys not in T.'
  from S[k not in T]
  expect given table T2 [ {k: 'a'} ]
         given S [ {k: 'a', n: 1, ts: timestamp '2026-01-01T10:00:00Z'} ]
         then Out [ {k: 'a', ts: timestamp '2026-01-01T10:00:00Z'} ]
  select k
  insert into Out;

rule R2
  intent 'Forward the keys in T2.'
  from S[k in T2]
  select k
  insert into Out2;
