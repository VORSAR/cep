-- expect: E-FN-001 (chain needs at least one capture) @ 16:15
language cep/0.1;

stream S (k string, kind string, n int, ts timestamp)
  time ts watermark bounded 1 min idle after 1 min;

stream Out (k string, evidence object, ts timestamp);

rule R
  intent 'An open, then a close on the same key.'
  partition by k of S ttl 1 hour
  from every o = S[kind == 'open'] -> c = S[kind == 'close']
  within 10 min
  after match skip past last
  late events drop
  select o.k, chain() as evidence
  insert into Out;
