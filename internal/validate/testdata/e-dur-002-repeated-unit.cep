-- expect: E-DUR-002 (min twice) @ 5:46
language cep/0.1;

stream S (k string, kind string, n int, ts timestamp)
  time ts watermark bounded 1 min idle after 5 min 5 min;

stream Out (k string, ts timestamp);

rule R
  intent 'Forward matching events.'
  from S[kind == 'x']
  select k
  insert into Out;
