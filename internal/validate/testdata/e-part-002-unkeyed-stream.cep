-- expect: E-PART-002 (the partition keys every stream the rule uses) @ 14:3
language cep/0.1;

stream Logins (user string, ok bool, ts timestamp)
  time ts watermark bounded 1 min idle after 1 min;

stream Resets (user string, ts timestamp)
  time ts watermark bounded 1 min idle after 1 min;

stream Out (user string, ts timestamp);

rule R
  intent 'A failed login, then a password reset for the same user.'
  partition by user of Logins ttl 1 hour
  from every f = Logins[ok == false] -> r = Resets
  within 5 min
  after match skip past last
  late events drop
  select f.user
  insert into Out;
