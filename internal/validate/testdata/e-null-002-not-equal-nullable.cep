-- expect: E-NULL-002 (not-equal over the optional note is false when note is null) @ 11:10
language cep/0.1;

stream S (k string, kind string, note string optional, ts timestamp)
  time ts watermark bounded 1 min idle after 1 min;

stream Out (k string, ts timestamp);

rule R
  intent 'Forward matching events.'
  from S[note != 'ok']
  select k
  insert into Out;
