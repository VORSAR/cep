-- expect: E-PARAM-001 (the keyword list has an empty item) @ 13:26
language cep/0.1;

param terms string = 'alpha, , beta';

stream S (k string, kind string, n int, ts timestamp)
  time ts watermark bounded 1 min idle after 1 min;

stream Out (k string, ts timestamp);

rule R
  intent 'Forward matching events.'
  from S[kind has_any_ci(${terms})]
  select k
  insert into Out;
