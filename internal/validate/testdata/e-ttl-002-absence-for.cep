-- expect: E-TTL-002 (ttl 10 min is smaller than the absence bound 20 min) @ 11:27
language cep/0.1;

stream S (k string, kind string, n int, ts timestamp)
  time ts watermark bounded 1 min idle after 1 min;

stream Out (k string, ts timestamp);

rule R
  intent 'A start with no stop on the same key in time.'
  partition by k of S ttl 10 min
  from every s = S[kind == 'start']
   and not S[kind == 'stop'] for 20 min
  within 5 min
  after match skip past last
  late events drop
  select s.k
  insert into Out;
