-- expect: E-PART-004 (a stream keyed twice in one partition clause) @ 11:24
language cep/0.1;

stream S (k string, j string, ts timestamp)
  time ts watermark bounded 1 min idle after 1 min;

stream Out (k string, ts timestamp);

rule R
  intent 'Alert per key at most once per 5 min.'
  partition by k of S, j of S ttl 10 min
  from S
  select k
  output first every 5 min
  insert into Out;
