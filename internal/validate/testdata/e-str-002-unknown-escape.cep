-- expect: E-STR-002 (backslash-q is not a listed escape) @ 11:18
language cep/0.1;

stream S (k string, kind string, n int, ts timestamp)
  time ts watermark bounded 1 min idle after 1 min;

stream Out (k string, ts timestamp);

rule R
  intent 'Forward matching events.'
  from S[kind == 'C:\qdata']
  select k
  insert into Out;
