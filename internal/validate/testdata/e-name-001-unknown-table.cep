-- expect: E-NAME-001 (no table AllowedKind, nearest AllowedKinds) @ 13:18
language cep/0.1;

stream S (k string, kind string, n int, ts timestamp)
  time ts watermark bounded 1 min idle after 1 min;

table AllowedKinds (kind string) primary key (kind);

stream Out (k string, ts timestamp);

rule R
  intent 'Forward matching events.'
  from S[kind in AllowedKind]
  select k
  insert into Out;
