-- expect: E-DUR-003 (idle after needs a duration above zero) @ 5:46
language cep/0.1;

stream S (k string, kind string, n int, ts timestamp)
  time ts watermark bounded 1 min idle after 0 ms;

stream Out (k string, ts timestamp);

rule R
  intent 'Forward matching events.'
  from S[kind == 'x']
  select k
  insert into Out;
